{
  "manifest_version": 3,
  "name": "EarnedTime Blocker",
  "version": "0.1.0",
  "description": "Blocks the tracked sites unless an EarnedTime session is running.",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EarnedTime",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
