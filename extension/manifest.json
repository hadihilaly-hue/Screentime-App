{
  "manifest_version": 3,
  "name": "EarnedTime Blocker",
  "version": "0.4.0",
  "description": "Blocks the tracked sites on the EarnedTime schedule, and unlocks one when you spend minutes on it.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EarnedTime",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
