{
  "manifest_version": 3,
  "name": "EarnedTime Blocker",
  "version": "0.5.1",
  "description": "Blocks the tracked sites on the EarnedTime schedule, and unlocks one when you spend minutes on it.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
"externally_connectable": {
  "matches": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://screentime-app-orpin.vercel.app/*"
  ]
},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EarnedTime",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
