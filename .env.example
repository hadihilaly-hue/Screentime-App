# Copy to .env and fill in from Supabase dashboard → Project Settings → API.
# The anon key is safe in a browser bundle; the service_role key is NOT — never put it here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The Chrome extension's id from chrome://extensions (the long
# lowercase string on its card). With it, ending a session early tells the
# extension to re-block immediately instead of within its one-minute poll.
# Leave it unset if you do not run the extension — everything still works, the
# block just comes back on the poll. The extension must also list this app's
# origin under externally_connectable in extension/manifest.json.
VITE_EXTENSION_ID=
