# Frontend (safe to expose — the anon key is protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Edge Function secrets — set with `supabase secrets set`, NEVER put these in a
# VITE_ variable and never commit them.
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-sonnet-4-6   (optional, this is the default)

# Set to true only long enough to create your one account, then remove it.
# VITE_ALLOW_SIGNUP=true
